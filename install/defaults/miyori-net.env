# Аплинк сетевой машины: vfio — настоящая карта, captive — измерительный мост, none — без выхода
MIYORI_UPLINK=vfio
MIYORI_UPLINK_PCI=0000:0c:00.0
MIYORI_UPLINK_IFC=enp12s0

# Линк хоста наружу через miyori-net (ADR-10): пусто — линка нет, --host-link — есть.
# Значением служит сам флаг: у systemd нет условий в ExecStart, а пустая переменная не даёт аргумента
MIYORI_HOST_LINK=

# Пусто — выход мимо туннеля не заперт, как сегодня; заполнено — наружу с карты
# пускаются только эти адреса, и исход direct у sing-box перестаёт работать.
# Адрес вписывает оператор в живой /etc/miyorios/miyori-net.env — в репозиторий он не попадает.
MIYORI_VPS_ALLOW=
