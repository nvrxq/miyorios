# Разрешённые токены (ERE, целиком): частные и документационные сети, публичные резолверы, фикстуры тестов.
^10\.[0-9]+\.[0-9]+\.[0-9]+$
^127\.[0-9]+\.[0-9]+\.[0-9]+$
^192\.168\.[0-9]+\.[0-9]+$
^172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+$
^169\.254\.[0-9]+\.[0-9]+$
^0\.0\.0\.0$
^255\.255\.255\.(0|255)$
^(192\.0\.2|198\.51\.100|203\.0\.113)\.[0-9]+$
^(1\.1\.1\.1|1\.0\.0\.1|8\.8\.8\.8|8\.8\.4\.4|9\.9\.9\.9|149\.112\.112\.112)$
^2001:db8:
^2606:4700:4700::1111$
^2620:fe::fe$
^/home/(op|someone|nonstandard)$
^user@[0-9]+\.service$
^52:54:00:
^(00:00:00:00:00:00|ff:ff:ff:ff:ff:ff)$
# версия nekobox, а не адрес: разрешён ровно тот номер, что есть в дереве,
# иначе исключение открыло бы целую публичную сеть /24
^5\.11\.28\.1$
