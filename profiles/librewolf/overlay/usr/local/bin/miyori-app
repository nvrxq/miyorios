#!/bin/sh
# запускается waypipe-сервером, поэтому WAYLAND_DISPLAY уже выставлен им
export GDK_BACKEND=wayland
# без него firefox поднимает xwayland-путь и упирается в отсутствующий X-сервер
export MOZ_ENABLE_WAYLAND=1
# без UTF-8 локали readline режет многобайтные символы: кириллицу в терминале не набрать
LANG=C.UTF-8
LC_ALL=C.UTF-8
export LANG LC_ALL
# HOME на постоянном томе: "Сбросить систему" обязан сохранить профиль браузера, стирает его только "Сбросить всё"
if [ -d /data ]; then
  HOME=/data/home
else
  HOME=/root
fi
export HOME
mkdir -p "$HOME"
# /etc/profile.d читает только login-шелл, а foot запускает обычный интерактивный
[ -e "$HOME/.bashrc" ] || cp /usr/share/miyori/bashrc "$HOME/.bashrc"
export TERM=foot

lw=/opt/librewolf/librewolf

# без machine-id dbus-run-session не поднимает шину, и firefox умирает ещё до открытия дисплея:
# gdk_display_open возвращает NULL, а он печатает "we don't have any display" и выходит
[ -s /etc/machine-id ] || dbus-uuidgen > /etc/machine-id

# терминал живёт фоном в той же сессии waypipe, что и браузер: её держит открытой librewolf,
# поэтому терминал можно закрыть, не уронив то, что из него запустили
foot &
shell_pid=$!

started="$(cut -d' ' -f1 /proc/uptime)"
# своя сессионная шина: dbus autolaunch умеет только через X11, которого здесь нет
dbus-run-session -- "$lw"
code=$?
ended="$(cut -d' ' -f1 /proc/uptime)"
echo "MIYORI: librewolf завершился с кодом $code, аптайм $ended"

# мгновенный выход — это отказ запуска, а не закрытое окно: спейс не гасим, оператору нужен шелл
if awk -v a="$started" -v b="$ended" 'BEGIN { exit !(b - a < 5) }'; then
  echo "MIYORI: librewolf не прожил и пяти секунд — оставляю терминал открытым"
  wait "$shell_pid"
else
  kill "$shell_pid" 2>/dev/null
fi
